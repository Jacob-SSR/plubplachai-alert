APP_ORIGIN=http://localhost:5700
DB_HOST=127.0.0.1
DB_PORT=3308
# Host ports used by docker compose. Chosen so this system runs next to plaplachai-health-check
# (3307/6060/5600). DB_PORT must equal MYSQL_HOST_PORT for tools run on the host.
MYSQL_HOST_PORT=3308
PMA_HOST_PORT=6070
APP_HOST_PORT=5700
# Web listens on all interfaces so other computers can open http://<server-ip>:5700.
# Then APP_ORIGIN must be that exact address, e.g. http://192.168.1.10:5700. MySQL/phpMyAdmin stay local.
APP_BIND=0.0.0.0
DB_NAME=ppc_alert
DB_USER=alert_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
ADMIN_USERNAME=admin
# Used by npm run db:bootstrap only. Remove ADMIN_PASSWORD afterwards.
ADMIN_PASSWORD=

# Copy Client_ID and Secret from MOPH CMS > API Key. Can be the same pair as plaplachai-health-check.
# Live sends also require LIVE enabled in the admin page and a running worker.
MOPH_LIVE_ENABLED=false
MOPH_CLIENT_KEY=
MOPH_SECRET_KEY=
# Leave empty unless your provider explicitly requires additional Bearer authentication.
MOPH_BEARER_TOKEN=
# Notice style: flex (own LINE card with hospital logo, falls back to MOPH template if rejected),
# template (MOPH Alert Template 3.1 card) or freeform (plain text).
MOPH_API_MODE=flex
MOPH_TEMPLATE_NAME=ยินดีต้อนรับ
# Public HTTPS URL of the logo in the flex card. Defaults to APP_ORIGIN/hospital-logo.png when APP_ORIGIN is https.
PUBLIC_LOGO_URL=
# Hospital photo behind the card header (public https). Empty = hospital-header.jpg next to the logo, or the copy
# in this project's public GitHub repository when the logo is hosted elsewhere.
PUBLIC_HEADER_URL=
# Pause between two messages (ms). Keeps a morning of reminders from flooding the MOPH API.
MOPH_SEND_INTERVAL_MS=500
# Shown in every notice: "หากต้องการเลื่อนนัด โปรดติดต่อ ..." e.g. ห้องบัตร โทร 044-000000
HOSPITAL_CONTACT=

# HOSxP source connection. Use a SELECT-only account for oapp, patient, clinic, doctor, kskdepartment
# (and lab_app_head, lab_app_order, lab_app_order_service, lab_items for LAB items).
# The CID is read from patient only at the moment a notice is sent, and is never stored.
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=
HOSXP_DB_USER=
HOSXP_DB_PASSWORD=
HOSXP_DB_CHARSET=tis620
# Comma-separated active oapp_status_id values. NULL and 1 are normal appointments.
HOSXP_ACTIVE_STATUS_IDS=NULL,1
# How many days ahead are watched, and how often HOSxP is read (seconds).
HOSXP_SYNC_DAYS=60
HOSXP_SYNC_INTERVAL_SECONDS=120
